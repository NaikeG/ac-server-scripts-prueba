sim = ac.getSim()
car = ac.getCar(0)

local adminFlag = ui.OnlineExtraFlags.Admin

local state = {
    enabled = false,
    alpha = 0
}

-- Config (se sobreescribe desde Extra Options, sección [ROLLINGSTART])
local maxSpeed = 80          -- km/h límite durante la largada en movimiento
local speedMargin = 3        -- km/h de tolerancia antes de penalizar (evita falsos positivos por el pit limiter, que oscila un poco alrededor del límite)
local restrictorDuration = 3 -- segundos que dura la penalidad
local restrictorValue = 1.0  -- 0 = sin restricción, 1 = restricción máxima
local greenHoldTime = 1.5    -- segundos que se ve el flash verde al dar la largada

-- Estado interno
local restrictorActive = false
local restrictorTimer = 0
local overSpeedFlag = false -- evita re-aplicar la penalidad en cada frame mientras sigue arriba del límite
local prevEnabled = false
local greenFlashTimer = 0

local title = "LARGADA EN MOVIMIENTO"

local lightCount = 6
local neonRed = rgbm(1.6, 0.05, 0.05, 1)
local neonGreen = rgbm(0.05, 1.8, 0.1, 1)

local screen = {
    w = sim.windowWidth,
    h = sim.windowHeight
}

-- Diagnóstico único: lista todos los tipos de penalidad reales disponibles en esta versión de CSP
local penaltyTypesLogged = false
local function logAvailablePenaltyTypes()
    if penaltyTypesLogged then return end
    penaltyTypesLogged = true
    local ok, err = pcall(function()
        local names = {}
        for k, v in pairs(ac.PenaltyType) do
            table.insert(names, tostring(k) .. "=" .. tostring(v))
        end
        ac.log("[ROLLINGSTART] ac.PenaltyType disponibles: " .. table.concat(names, ", "))
    end)
    if not ok then
        ac.log("[ROLLINGSTART] No se pudo enumerar ac.PenaltyType: " .. tostring(err))
    end
end

rollingStartEvent = ac.OnlineEvent({
    key = ac.StructItem.key("Rolling Start"),
    enabled = ac.StructItem.boolean()
}, function(sender, message)
    state.enabled = message.enabled
    overSpeedFlag = false
    ac.log(
        "[ROLLINGSTART] " ..
        sender:driverName() ..
        " -> " ..
        tostring(state.enabled)
    )
end,
ac.SharedNamespace.ServerScript)

ac.onResolutionChange(function()
    screen.w = ac.getSim().windowWidth
    screen.h = ac.getSim().windowHeight
end)

ac.onOnlineWelcome(function(message, config)
    if config:get("ROLLINGSTART", "ADMIN_ONLY", 1) == 0 then
        adminFlag = ui.OnlineExtraFlags.None
    else
        adminFlag = ui.OnlineExtraFlags.Admin
    end

    maxSpeed = config:get("ROLLINGSTART", "MAX_SPEED_KMH", 80)
    speedMargin = config:get("ROLLINGSTART", "SPEED_MARGIN_KMH", 3)
    restrictorDuration = config:get("ROLLINGSTART", "RESTRICTOR_DURATION", 3)
    restrictorValue = config:get("ROLLINGSTART", "RESTRICTOR_VALUE", 1.0)
    greenHoldTime = config:get("ROLLINGSTART", "GREEN_HOLD_TIME", 1.5)

    ui.registerOnlineExtra(
        ui.Icons.Warning,
        "🚦 Largada en Movimiento",
        function() return true end,
        nil,
        function()
            state.enabled = not state.enabled
            overSpeedFlag = false
            rollingStartEvent({ enabled = state.enabled })
            ac.log("[ROLLINGSTART] Estado: " .. tostring(state.enabled))
        end,
        adminFlag
    )

    logAvailablePenaltyTypes()
end)

local function applyRestrictor(value)
    -- Prueba varias funciones candidatas de CSP. Antes de intentar cada una,
    -- verifica que el valor de enum exista de verdad (si no, pcall "funciona"
    -- en falso porque nil se traduce silenciosamente a 0 del lado de C++).
    local attempts = {}

    if ac.PenaltyType.Restrictor ~= nil then
        table.insert(attempts, {
            name = "physics.setCarPenalty(ac.PenaltyType.Restrictor, value)",
            fn = function() physics.setCarPenalty(ac.PenaltyType.Restrictor, value) end
        })
    end

    if ac.PenaltyType.EngineRestrictor ~= nil then
        table.insert(attempts, {
            name = "physics.setCarPenalty(ac.PenaltyType.EngineRestrictor, value)",
            fn = function() physics.setCarPenalty(ac.PenaltyType.EngineRestrictor, value) end
        })
    end

    table.insert(attempts, {
        name = "ac.setCarRestrictor(0, value)",
        fn = function() ac.setCarRestrictor(0, value) end
    })
    table.insert(attempts, {
        name = "physics.setExtraRestrictor(value)",
        fn = function() physics.setExtraRestrictor(value) end
    })

    for _, attempt in ipairs(attempts) do
        local ok, err = pcall(attempt.fn)
        if ok then
            return true
        end
    end

    -- Respaldo: bloquea la caja de cambios (te deja en neutro / sin poder meter marcha)
    local ok, err = pcall(function() physics.lockUserGearboxFor(restrictorDuration, true) end)
    if not ok then
        ac.log("[ROLLINGSTART] ERROR con alternativa de caja: " .. tostring(err))
    end
    return false
end

function script.update(dt)
    -- Detecta el momento en que se da la largada (pasa de activo a inactivo)
    if prevEnabled and not state.enabled then
        greenFlashTimer = greenHoldTime
    end
    prevEnabled = state.enabled

    if greenFlashTimer > 0 then
        greenFlashTimer = math.max(greenFlashTimer - dt, 0)
    end

    -- Fade del panel
    local fadeSpeed = 3.5
    if state.enabled or restrictorActive or greenFlashTimer > 0 then
        state.alpha = math.min(state.alpha + dt * fadeSpeed, 1)
    else
        state.alpha = math.max(state.alpha - dt * fadeSpeed, 0)
    end

    -- Cuenta regresiva de la penalidad activa
    if restrictorTimer > 0 then
        restrictorTimer = restrictorTimer - dt
        if restrictorTimer <= 0 then
            restrictorTimer = 0
            restrictorActive = false
            applyRestrictor(0)
        end
    end

    -- Control de velocidad
    if state.enabled then
        if car.speedKmh > maxSpeed + speedMargin then
            if not overSpeedFlag then
                overSpeedFlag = true
                ac.sendChatMessage(
                    car:driverName() ..
                    " superó los " .. maxSpeed .. " km/h en la largada en movimiento. Restrictor aplicado por " ..
                    restrictorDuration .. "s."
                )
                applyRestrictor(restrictorValue)
                restrictorActive = true
                restrictorTimer = restrictorDuration
            end
        else
            overSpeedFlag = false
        end
    else
        overSpeedFlag = false
    end
end

local function alphaColor(r, g, b, mult)
    return rgbm(r, g, b, state.alpha * (mult or 1))
end

function script.drawUI()
    if state.alpha <= 0 then
        return
    end

    local phase = nil
    if state.enabled then
        phase = "red"
    elseif greenFlashTimer > 0 then
        phase = "green"
    end

    local panelWidth = 700
    local panelHeight = 300
    local x = (screen.w - panelWidth) * 0.5
    local y = 110

    -- Carcasa del panel
    local borderColor
    if restrictorActive then
        borderColor = alphaColor(1.0, 0.15, 0.1)
    else
        borderColor = alphaColor(1.0, 0.82, 0.0)
    end
    ui.drawRectFilled(vec2(x, y), vec2(x + panelWidth, y + panelHeight), alphaColor(0.03, 0.03, 0.03, 0.92), 14)
    ui.drawRect(vec2(x, y), vec2(x + panelWidth, y + panelHeight), borderColor, 14, 0, 3)

    ------------------------------------------------
    -- Título
    ------------------------------------------------
    ui.pushFont(ui.Font.Title)
    local titleSize = ui.measureText(title)
    ui.setCursor(vec2(x + (panelWidth - titleSize.x) * 0.5, y + 22))
    ui.pushStyleColor(ui.StyleColor.Text, alphaColor(1.0, 0.82, 0.0))
    ui.text(title)
    ui.popStyleColor()
    ui.popFont()

    ------------------------------------------------
    -- Semáforo tipo gantry (rojo = límite activo, verde = largada dada)
    ------------------------------------------------
    if phase ~= nil then
        local litColor = (phase == "red") and neonRed or neonGreen
        local radius = 26
        local lightsRowY = y + 130
        local lightsStartX = x + (panelWidth - (lightCount - 1) * (radius * 2.4)) * 0.5

        local blinkOn = true
        if phase == "green" then
            local blinkInterval = 180
            blinkOn = math.floor(sim.currentSessionTime / blinkInterval) % 2 == 0
        end

        for i = 1, lightCount, 1 do
            local center = vec2(lightsStartX + (i - 1) * radius * 2.4, lightsRowY)

            -- Portalámpara (bezel oscuro)
            ui.drawCircleFilled(center, radius + 6, alphaColor(0.10, 0.10, 0.10, 1), 32)
            ui.drawCircle(center, radius + 6, alphaColor(0.22, 0.22, 0.22, 1), 32, 1.5)

            local isLit = (phase == "red") or (phase == "green" and blinkOn)
            if isLit then
                ui.drawCircleFilled(center, radius * 2.1, rgbm(litColor.r, litColor.g, litColor.b, state.alpha * 0.12), 32)
                ui.drawCircleFilled(center, radius * 1.5, rgbm(litColor.r, litColor.g, litColor.b, state.alpha * 0.28), 32)
                ui.drawCircleFilled(center, radius, rgbm(litColor.r, litColor.g, litColor.b, state.alpha), 32)
                ui.drawCircle(center, radius, alphaColor(1, 1, 1, 0.35), 32, 1)
            else
                ui.drawCircleFilled(center, radius, alphaColor(0.16, 0.02, 0.02, 1), 32)
            end
        end
    end

    ------------------------------------------------
    -- Límite de velocidad / velocidad actual
    ------------------------------------------------
    local subtitle = "MÁXIMO " .. maxSpeed .. " KM/H   |   ACTUAL " .. math.round(car.speedKmh, 0) .. " KM/H"
    ui.pushFont(ui.Font.Main)
    local subSize = ui.measureText(subtitle)
    ui.setCursor(vec2(x + (panelWidth - subSize.x) * 0.5, y + 200))
    local speedColor
    if car.speedKmh > maxSpeed + speedMargin then
        speedColor = alphaColor(1.0, 0.2, 0.15)
    else
        speedColor = alphaColor(1, 1, 1)
    end
    ui.pushStyleColor(ui.StyleColor.Text, speedColor)
    ui.text(subtitle)
    ui.popStyleColor()
    ui.popFont()

    ------------------------------------------------
    -- Aviso de penalidad
    ------------------------------------------------
    if restrictorActive then
        local warnText = "¡RESTRICTOR ACTIVO! (" .. math.ceil(restrictorTimer) .. "s)"
        ui.pushFont(ui.Font.Main)
        local warnSize = ui.measureText(warnText)
        ui.setCursor(vec2(x + (panelWidth - warnSize.x) * 0.5, y + 250))
        local blink = (math.floor(sim.currentSessionTime / 200) % 2 == 0)
        local warnAlphaMult = blink and 1 or 0.35
        ui.pushStyleColor(ui.StyleColor.Text, alphaColor(1.0, 0.15, 0.1, warnAlphaMult))
        ui.text(warnText)
        ui.popStyleColor()
        ui.popFont()
    end
end
